Subject: AmigaOS: authorized_keys in DEVS:Internet/sshd, readability check

The default directory of authorized_keys is AMIGA_SSHD_DIR
(port/amiga_paths.h) instead of "~/.ssh". AmigaOS files have no owner and
no Unix permission bits, so checkpubkeyperms() checks only that the file
can be opened for reading; checkfileperm() is left out.

diff --git a/src/svr-authpubkey.c b/src/svr-authpubkey.c
index 938b52da..052b9dc5 100644
--- a/src/svr-authpubkey.c
+++ b/src/svr-authpubkey.c
@@ -82,7 +82,9 @@ static int checkpubkey(const char* keyalgo, unsigned int keyalgolen,
 static int checkpubkeyperms(void);
 static void send_msg_userauth_pk_ok(const char* sigalgo, unsigned int sigalgolen,
 		const unsigned char* keyblob, unsigned int keybloblen);
+#ifndef __amigaos__
 static int checkfileperm(char * filename);
+#endif
 
 /* process a pubkey auth request, sending success or failure message as
  * appropriate */
@@ -576,6 +578,27 @@ out:
  * When this path is inside the user's home dir it checks up to and including
  * the home dir, otherwise it checks every path component. */
 static int checkpubkeyperms() {
+#ifdef __amigaos__
+	/* AmigaOS files have no owner and no Unix permission modes, so the
+	 * ownership and group/other-write checks below have nothing to test.
+	 * What remains meaningful is that the file exists and can be read. */
+	char *path = authorized_keys_filepath();
+	int fd, ret = DROPBEAR_FAILURE;
+
+	TRACE(("enter checkpubkeyperms"))
+
+	fd = open(path, O_RDONLY);
+	if (fd >= 0) {
+		m_close(fd);
+		ret = DROPBEAR_SUCCESS;
+	} else {
+		TRACE(("checkpubkeyperms: can't read %s: %s", path, strerror(errno)))
+	}
+	m_free(path);
+
+	TRACE(("leave checkpubkeyperms"))
+	return ret;
+#else
 	char *path = authorized_keys_filepath(), *sep = NULL;
 	int ret = DROPBEAR_SUCCESS;
 
@@ -602,8 +625,10 @@ static int checkpubkeyperms() {
 
 	TRACE(("leave checkpubkeyperms"))
 	return ret;
+#endif /* __amigaos__ */
 }
 
+#ifndef __amigaos__
 /* Checks that a file is owned by the user or root, and isn't writable by
  * group or other */
 /* returns DROPBEAR_SUCCESS or DROPBEAR_FAILURE */
@@ -640,6 +665,7 @@ static int checkfileperm(char * filename) {
 	TRACE(("leave checkfileperm: success"))
 	return DROPBEAR_SUCCESS;
 }
+#endif /* !__amigaos__ */
 
 #if DROPBEAR_FUZZ
 void fuzz_checkpubkey_line(buffer* line, int line_num, char* filename,
diff --git a/src/svr-runopts.c b/src/svr-runopts.c
index 2baec6bd..9e828fdb 100644
--- a/src/svr-runopts.c
+++ b/src/svr-runopts.c
@@ -183,7 +183,12 @@ void svr_getopts(int argc, char ** argv) {
 	svr_opts.hostkey = NULL;
 	svr_opts.delay_hostkey = 0;
 	svr_opts.pidfile = expand_homedir_path(DROPBEAR_PIDFILE);
+#ifdef __amigaos__
+	/* All server files live in one AmigaDOS directory (port/amiga_paths.h) */
+	svr_opts.authorized_keys_dir = AMIGA_SSHD_DIR;
+#else
 	svr_opts.authorized_keys_dir = "~/.ssh";
+#endif
 #if DROPBEAR_SVR_LOCALANYFWD
 	svr_opts.nolocaltcp = 0;
 #endif
