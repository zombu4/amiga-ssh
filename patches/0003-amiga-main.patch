 	if (signal(SIGINT, sigintterm_handler) == SIG_ERR || 
 #ifndef DEBUG_VALGRIND
@@ -474,6 +519,7 @@ static void commonsetup() {
 	if (signal(SIGSEGV, sigsegv_handler) == SIG_ERR) {
 		dropbear_exit("signal() error");
 	}
+#endif /* __amigaos__ */
 
