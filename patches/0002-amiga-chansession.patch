+#ifdef __amigaos__
+/* "NAME=VALUE" for the session's environment, in m_malloc()ed memory. */
+static char *amiga_env(const char *name, const char *value) {
+	size_t len = strlen(name) + 1 + strlen(value) + 1;
+	char *s = m_malloc(len);
+
+	snprintf(s, len, "%s=%s", name, value);
+	return s;
+}
+
+/* Starts the shell (chansess->cmd == NULL) or command for a channel through
+ * the port's console handler (port/amiga_session.h), in the account's home
+ * directory. The channel gets one connected socket for both directions, like
+ * upstream's pty master. bidir_fd is set so that close_chan_fd() shuts down
+ * one direction at a time and closes the socket only when both are done:
+ * the client's EOF must not cut off output that is still coming. errfd
+ * stays FD_CLOSED as set by newchannel(), since the handler sends the
+ * command's error output on the same socket.
+ * chansess->pid takes a number that is unique in this session and nonzero
+ * while the child runs, which sesscheckclose() and the childpids table rely
+ * on. Returns DROPBEAR_SUCCESS or DROPBEAR_FAILURE */
+static int amiga_startchild(struct Channel *channel, struct ChanSess *chansess,
+		int pty) {
+	static pid_t lastpid = 0;
+	struct amiga_child *child = NULL;
+	int fd = -1, n = 0, i, ret;
+	/* The variables upstream's execchild() sets that mean something here,
+	 * given to the shell or command as local variables. */
+	char *env[8];
+
+	env[n++] = amiga_env("USER", ses.authstate.pw_name);
+	env[n++] = amiga_env("LOGNAME", ses.authstate.pw_name);
+	env[n++] = amiga_env("HOME", ses.authstate.pw_dir);
+	if (chansess->term != NULL) {
+		env[n++] = amiga_env("TERM", chansess->term);
+	}
+	if (chansess->connection_string != NULL) {
+		env[n++] = amiga_env("SSH_CONNECTION", chansess->connection_string);
+	}
+	if (chansess->client_string != NULL) {
+		env[n++] = amiga_env("SSH_CLIENT", chansess->client_string);
+	}
+	env[n] = NULL;
+
+	ret = amiga_child_start(chansess->cmd, pty, chansess->amiga_cols,
+			chansess->amiga_rows, ses.authstate.pw_dir,
+			(const char *const *)env, &fd, &child);
+	for (i = 0; i < n; i++) {
+		m_free(env[i]);
+	}
+	if (ret < 0) {
+		dropbear_log(LOG_WARNING, "Couldn't start %s: %s",
+				chansess->cmd ? "command" : "shell", strerror(errno));
+		return DROPBEAR_FAILURE;
+	}
+
+	lastpid++;
+	if (lastpid <= 0) {
+		lastpid = 1;
+	}
+	chansess->amiga_child = child;
+	chansess->pid = lastpid;
+	addchildpid(chansess, chansess->pid);
+
+	channel->readfd = fd;
+	channel->writefd = fd;
+	channel->bidir_fd = 1;
+	ses.maxfd = MAX(ses.maxfd, fd);
+
+	return DROPBEAR_SUCCESS;
+}
+#endif /* __amigaos__ */
