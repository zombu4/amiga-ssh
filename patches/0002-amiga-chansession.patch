  * the parent when it runs. This work correctly at least in the case of a
  * single shell spawned (ie the usual case) */
 void svr_chansess_checksignal(void) {
+#ifdef __amigaos__
+	/* No SIGCHLD or waitpid() on AmigaOS. Every running child is polled
+	 * (amiga_child_finished() never blocks) on each pass, so a finish is
+	 * seen even if its signal was taken by an earlier wait. A child that has
+	 * finished gets its exit status filled in once, the way the code below
+	 * does for an exited pid; it ended normally, so exitsignal is -1. */
+	unsigned int i;
+
+	for (i = 0; i < svr_ses.childpidsize; i++) {
+		struct ChanSess *chansess = svr_ses.childpids[i].chansess;
+		long rc;
+
+		if (svr_ses.childpids[i].pid <= 0 || chansess == NULL
+				|| chansess->amiga_child == NULL
+				|| chansess->exit.exitpid != -1) {
+			continue;
+		}
+		if (amiga_child_finished(chansess->amiga_child, &rc)) {
+			TRACE(("svr_chansess_checksignal : child %d rc %ld",
+						chansess->pid, rc))
+			chansess->exit.exitpid = chansess->pid;
+			chansess->exit.exitstatus = (int)rc;
+			chansess->exit.exitsignal = -1;
+			chansess->exit.exitcore = 0;
+			/* makes channelio() run check_close() on the channels */
+			ses.channel_signal_pending = 1;
+		}
+	}
+#else
 	int status;
 	pid_t pid;
 
