+#ifdef __amigaos__
+	/* AmigaOS stops a shell or command with its break signal, Ctrl-C;
+	 * the signals that ask a process to end map to it. A child that has
+	 * already finished cannot take a signal, as kill() fails upstream. */
+	if (chansess->amiga_child == NULL || chansess->exit.exitpid != -1) {
